{
  "name": "@fab-orbita/shield",
  "version": "1.4.2",
  "description": "Advanced security framework for Node.js with AI-powered protection",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:clean && npm run build:rollup && npm run build:types",
    "build:clean": "rimraf dist",
    "build:rollup": "rollup -c rollup.config.mjs",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "build:watch": "rollup -c rollup.config.mjs -w",
    "build:analyze": "npm run build && source-map-explorer dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:unit": "jest tests/unit",
    "test:e2e": "jest tests/e2e",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage node_modules",
    "prepublishOnly": "npm run build && npm test",
    "dev": "ts-node examples/server.ts",
    "start": "node dist/index.js",
    "example": "ts-node examples/server.ts",
    "example:basic": "ts-node examples/basic.ts",
    "example:express": "ts-node examples/express.ts"
  },
  "peerDependencies": {
    "express": "^4.18.2 || ^5.0.0",
    "fastify": "^4.0.0",
    "koa": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "koa": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.55.0",
    "express": "^5.2.1",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "redis": "^6.1.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.9.6",
    "source-map-explorer": "^2.5.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3",
    "uuid": "^14.0.1",
    "winston": "^3.19.0"
  },
  "keywords": [
    "security",
    "nodejs-security",
    "api-security",
    "express-security",
    "fastify-security",
    "koa-security",
    "security-headers",
    "content-security-policy",
    "csp",
    "rate-limiting",
    "middleware",
    "waf",
    "firewall",
    "xss-protection",
    "csrf-protection",
    "hsts",
    "sql-injection",
    "nosql-injection",
    "path-traversal",
    "command-injection",
    "helmet-alternative",
    "http-security",
    "request-validation",
    "threat-detection",
    "ai-security",
    "metrics",
    "monitoring",
    "express-middleware",
    "nestjs-security",
    "typescript-security",
    "open-source-security",
    "fab",
    "shield",
    "fab-orbita",
    "devorbit"
  ],
  "author": {
    "name": "Фабрициус Владимир Николаевич",
    "email": "Director@devorbit.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zammartin2/shield.git"
  },
  "bugs": {
    "url": "https://github.com/zammartin2/shield/issues"
  },
  "homepage": "https://fab.devorbit.ru",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
