# Application
NODE_ENV=development
PORT=3000

# FAB Shield
SHIELD_ENABLED=true
SHIELD_NAME=My Shield
SHIELD_HEADERS=true
SHIELD_CSP=true
SHIELD_AI=true
SHIELD_MONITORING=true

# Security (HSTS — задаётся блоком, начиная с HSTS_MAX_AGE)
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Rate limiting (RATE_LIMIT_MAX включает rate limiting; без него остальные не действуют)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_ENABLED=true

# Logging (LOG_FORMAT применяется только при заданном LOG_LEVEL)
LOG_LEVEL=info
LOG_FORMAT=json
